# Copy to .env and fill in. .env is gitignored - never commit real secrets.

DATABASE_URL=postgresql+psycopg://hockey:hockey@localhost:5434/hockey_models

# --- Yahoo Fantasy Sports API (OAuth2) ---
# From https://developer.yahoo.com/apps/ -> your app.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match a Redirect URI registered on the Yahoo app EXACTLY, including the
# port. Yahoo does allow https://localhost:<port>; a mismatched port is
# rejected the same way a wrong host is, with 'invalid redirect uri'.
YAHOO_REDIRECT_URI=https://localhost:8080
# Fantasy Sports scope, matching the app's API Permissions setting:
# fspt-w for Read/Write, fspt-r for Read.
YAHOO_SCOPE=fspt-w
# The numeric id from your league URL:
# https://hockey.fantasysports.yahoo.com/hockey/<THIS NUMBER>
YAHOO_LEAGUE_ID=
