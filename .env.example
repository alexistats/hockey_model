# Copy to .env and fill in. .env is gitignored - never commit real secrets.

DATABASE_URL=postgresql+psycopg://hockey:hockey@localhost:5434/hockey_models

# --- Yahoo Fantasy Sports API (OAuth2) ---
# From https://developer.yahoo.com/apps/ -> your app.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match what the Yahoo app accepts, EXACTLY. Yahoo rejects localhost and
# 127.0.0.1 outright, so an app registered without a hosted callback uses the
# out-of-band flow: Yahoo shows the authorization code on the page instead of
# redirecting anywhere. Leave this as oob unless the app has a real HTTPS
# callback registered.
YAHOO_REDIRECT_URI=oob
# Fantasy Sports scope. An app registered Read/Write takes fspt-w and rejects
# fspt-r; an app registered Read-only takes fspt-r. Omitting it entirely gets
# a token that 403s on every call.
YAHOO_SCOPE=fspt-w
# The numeric id from your league URL:
# https://hockey.fantasysports.yahoo.com/hockey/<THIS NUMBER>
YAHOO_LEAGUE_ID=
